# FIXTURES
# ------------------------------------------------------------------
#

@tel Annex Vestibule

#
@spawn annex_waiver

#
@spawn annex_signin_ledger

#
@tel Requisition and Returns

#
@spawn requisition_ledger

#
@spawn practice_rack

#
@tel Assessment Records Office

#
@spawn depreciation_file

#
@spawn suggestion_box

#
@tel Practical Assessment Floor

#
@spawn dummy_floor_plain

#
@spawn dummy_floor_armored

#
@spawn bartholomew

#
@tel Ranged Discharge Gallery

#
@spawn dummy_range_static

#
@spawn dummy_range_swinging

#
@spawn range_backstop

#
@tel Applied Technique Hall

#
@spawn dummy_technique

#
@tel Cadence Corridor

#
@spawn annex_plan

#
@tel Evocation Cell

#
@spawn ward_target

#
@spawn ward_hairline

#
@spawn ward_survey_plates

#
@tel Adverse Conditions Suite

#
@spawn condition_kit

#
@tel Concurrent Engagement Pit

#
@spawn dummy_pit_a

#
@spawn dummy_pit_b

#
@spawn dummy_pit_c

#
@tel Observation Gallery

#
@spawn assessment_slate

#
# ------------------------------------------------------------------
# Done
# ------------------------------------------------------------------
#

@tel Annex Vestibule

#
@py self.msg("=== Practical Assessment Annex build complete. ===")

#
